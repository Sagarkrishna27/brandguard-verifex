# Local defaults. In production, set exact HTTPS origins and URLs.
BRANDGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BRANDGUARD_PUBLIC_URL=http://127.0.0.1:8000

# Required only to issue public HTTPS report-verification QR codes.
# BRANDGUARD_FRONTEND_URL=https://your-frontend.example

# Set to a durable mounted directory in production; default is this backend folder.
# BRANDGUARD_DATA_DIR=/var/data

# Reviewer authorization is backend-only. Generate a private random value and
# store it in the hosting provider's secret settings. Never use a VITE_ variable.
# BRANDGUARD_REVIEWER_TOKEN=replace-with-a-long-random-secret

# Optional poster enrichment key. The local composition engine works without it.
# BRANDGUARD_AI_KEY=

# Shared model used by all Gemini-enabled backend features.
GEMINI_MODEL=gemini-3.5-flash-lite
